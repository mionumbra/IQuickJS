[global] function iqjs_unsafe_free([type_hint = `uint64`] ctx, [type_hint = `uint64`] pointer) : unit;
[global, type_hint = `uint64`] function iqjs_unsafe_malloc_usable_size([type_hint = `uint64`] ctx, [type_hint = `uint64`] pointer) : gmval;
