// IQuickJS: QuickJS-NG 0.15.1 public API for GameMaker.
// Runtime, Context, Value, Atom, ClassID, Module, Pointer and callback-registration
// tokens are opaque uint64 handles. Returned strings and byte arrays are copies.
// Functions named iqjs_unsafe_* expose native memory addresses. Passing an invalid,
// stale, foreign-runtime or incorrectly sized pointer can crash or corrupt the process.

[gml_api]
module IQuickJS;

// =============================================================================
// Runtime
// =============================================================================

[start_fn]
function iqjs_init() : unit;
[finish_fn]
function iqjs_shutdown() : unit;

[global, type_hint = `uint64`] function iqjs_new_runtime() : gmval;
// Adapter for JS_NewRuntime2: allocators are selected from native policies, never GML callbacks.
[global, type_hint = `uint64`] function iqjs_unsafe_new_runtime_with_allocator(policy : string, [type_hint = `uint64`] opaque) : gmval;
[global] function iqjs_free_runtime([type_hint = `uint64`] rt) : unit;
[global] function iqjs_set_runtime_info([type_hint = `uint64`] rt, info : string) : unit;
[global] function iqjs_set_dump_flags([type_hint = `uint64`] rt, [type_hint = `IQJSDumpFlags`] flags : int64) : unit;
[global, type_hint = `uint64`] function iqjs_get_dump_flags([type_hint = `uint64`] rt) : gmval;
[global] function iqjs_update_stack_top([type_hint = `uint64`] rt) : unit;
[global] function iqjs_run_gc([type_hint = `uint64`] rt) : unit;
[global] function iqjs_is_live_object([type_hint = `uint64`] rt, [type_hint = `uint64`] value) : bool;
[global] function iqjs_set_can_block([type_hint = `uint64`] rt, can_block : bool) : unit;
[global] function iqjs_is_job_pending([type_hint = `uint64`] rt) : bool;
[global, type_hint = `uint64`] function iqjs_get_pending_job_context([type_hint = `uint64`] rt) : gmval;
[global, type_hint = `IQJSJobResult`] function iqjs_execute_pending_job([type_hint = `uint64`] rt) : gmval;
[global] function iqjs_get_version() : string;
// Adapter for JS_Get/SetRuntimeOpaque and JS_AddRuntimeFinalizer: opaque tokens are not dereferenced.
[global] function iqjs_unsafe_set_runtime_opaque([type_hint = `uint64`] rt, [type_hint = `uint64`] pointer) : unit;
[global, type_hint = `uint64`] function iqjs_unsafe_get_runtime_opaque([type_hint = `uint64`] rt) : gmval;
[global, type_hint = `uint64`] function iqjs_add_runtime_finalizer_adapter([type_hint = `uint64`] rt, callback : func, [type_hint = `uint64`] arg) : gmval;
[global] function iqjs_remove_runtime_finalizer_adapter([type_hint = `uint64`] registration) : unit;
// Adapter for JS_MarkValue: marks through a native GC traversal registered for this runtime.
[global] function iqjs_mark_value_adapter([type_hint = `uint64`] rt, [type_hint = `uint64`] value) : unit;

